{
  "name": "kotbot-pos-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/fix-vite-perms.mjs && npx vite build",
    "preview": "node ./scripts/fix-vite-perms.mjs && npx vite preview --host 0.0.0.0",
    "start": "node ./scripts/fix-vite-perms.mjs && npx vite preview --host 0.0.0.0 --port ${PORT:-4173}"
  },
  "dependencies": {
    "axios": "^1.7.3",
    "lucide-react": "^1.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
