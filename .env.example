# Vite dev proxy target (host only). Used by `vite.config.js` proxy.
# For local development a backend is expected on http://localhost:5001, so the
# default proxy target is localhost:5001 — no env var is required.
#
# To override the proxy target (e.g. the production Railway backend):
# VITE_API_TARGET=https://synora-pos-backend-production-1fd4.up.railway.app

# Optional: bypass the dev proxy and call the API directly from the browser
# (include the /api path). Used by src/api/pos.js when this is set.
# VITE_API_BASE=http://localhost:5001/api
